# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored. Never commit real keys.

# Groq, used for Whisper transcription. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini, used for summaries and notes. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared secret the app sends during early development. Replaced by real user accounts later.
APP_SECRET=
